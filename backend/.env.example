# ANATO3D backend configuration example.
#
# Copy to `.env` (in the backend directory) and edit as needed. Every variable
# uses the ANATO3D_ prefix. Values shown are the built-in defaults.

# -- general ---------------------------------------------------------------
ANATO3D_DEBUG=false

# -- storage ---------------------------------------------------------------
# Root for ALL working data (uploads + derived artefacts). Disposable.
ANATO3D_DATA_DIR=_work
# Delete workspaces idle for longer than this.
ANATO3D_WORKSPACE_TTL_MINUTES=240
# Background reaper interval (seconds).
ANATO3D_REAPER_INTERVAL_SECONDS=300

# -- upload limits ---------------------------------------------------------
# 512 MiB per file, 2 GiB per request, 4000 files per request.
ANATO3D_MAX_FILE_BYTES=536870912
ANATO3D_MAX_UPLOAD_BYTES=2147483648
ANATO3D_MAX_UPLOAD_FILES=4000

# -- processing limits -----------------------------------------------------
# Above the soft limit the volume is downsampled before segmentation.
ANATO3D_MAX_VOXELS_SOFT=220000000
# Above the hard limit the request is refused.
ANATO3D_MAX_VOXELS_HARD=900000000

# -- CORS (browser origins allowed to call the API directly) ---------------
# ANATO3D_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -- dev launcher ----------------------------------------------------------
ANATO3D_HOST=127.0.0.1
ANATO3D_PORT=8000
ANATO3D_RELOAD=0

# -- optional AI segmentation (MONAI bundle) -------------------------------
# Uncomment and set these AFTER installing monai + torch and providing a bundle.
# ANATO3D_AI_MODEL_PATH=/absolute/path/to/monai_bundle
# ANATO3D_AI_INPUT_KEY=image
# ANATO3D_AI_OUTPUT_KEY=pred
# ANATO3D_AI_DEVICE=cpu
